# NOTE: if you copied an OLDER version of this file, make sure it says TTS_PROVIDER=openrouter (below)
# and that FISH_API_KEY is empty. A Fish-only setting with an OpenRouter key causes "Invalid Token".

# ---- General ----
APP_ENV=development            # "production" disables admin routes unless ADMIN_API_KEY is set
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_ACCESS_KEY=                # optional shared secret; clients send it as X-API-Key
ADMIN_API_KEY=                 # required for /admin/* in production
SUPPORT_EMAIL=support@example.com

# ---- LLM: NVIDIA Nemotron 3.5 Super VL (free) via OpenRouter ----
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=1500
LLM_REASONING_EFFORT=          # optional: low | medium | high

# ---- STT: local Faster-Whisper (no API key) ----
STT_PROVIDER=faster_whisper_local
# Pick the model by your computer (all free, run locally, downloaded once):
#   distil-large-v3  ~1.5 GB  RECOMMENDED for English: near large-v3 accuracy, much faster. Needs ~3 GB RAM.
#   small.en         ~0.5 GB  good if your PC is weak/old
#   large-v3-turbo   ~1.6 GB  if you later need many languages (set STT_LANGUAGE= empty)
#   large-v3         ~3 GB    most accurate, slow on CPU (use with a GPU: STT_DEVICE=cuda)
#   base.en          ~0.15 GB too inaccurate for real speech -- not recommended
STT_MODEL=distil-large-v3
STT_DEVICE=cpu                 # cuda for NVIDIA GPUs
STT_COMPUTE_TYPE=int8          # float16 on GPU
STT_LANGUAGE=en
# STT_INITIAL_PROMPT=   # vocabulary hint (default mentions Northstar plans/add-ons); empty disables
STT_BEAM_SIZE=1                # 1 = fast greedy decoding on CPU; 5 = slightly more accurate, slower
STT_VAD_FILTER=true
STT_DOWNLOAD_ROOT=             # empty = default Hugging Face cache (~/.cache/huggingface/hub)
STT_LOCAL_FILES_ONLY=false     # true = never touch the network (model must be cached)
STT_PRELOAD=true
STT_MAX_UPLOAD_BYTES=10485760
STT_MAX_DURATION_SECONDS=120
STT_MAX_CONCURRENCY=1
STT_TIMEOUT_SECONDS=90

# ---- TTS: Fish Audio S2.1 Pro Free, through OpenRouter (uses the SAME OPENROUTER_API_KEY above) ----
TTS_PROVIDER=openrouter
TTS_MODEL=fish-audio/s2.1-pro-free:free   # OpenRouter's free variant slug (the app also tries the name without :free)
# TTS_MODEL_FALLBACKS=fish-audio/s2.1-pro   # optional PAID fallback (~$15 per million bytes of text); needs credits
TTS_DEFAULT_VOICE_ID=          # optional Fish voice id; empty = provider default voice
FISH_ALLOWED_VOICE_IDS=        # optional "voiceId:Label,voiceId2:Label2" shown in Voice Settings

# Alternative: call Fish Audio directly. Needs a *Fish Audio* key from fish.audio/app/api-keys
# (an OpenRouter key will be rejected there with "rejected the API key").
# TTS_PROVIDER=fish_audio
# FISH_API_KEY=
# FISH_TTS_MODEL=s2.1-pro-free   # or s2.1-pro
# FISH_TTS_FORMAT=mp3
FISH_TTS_TIMEOUT_SECONDS=60
